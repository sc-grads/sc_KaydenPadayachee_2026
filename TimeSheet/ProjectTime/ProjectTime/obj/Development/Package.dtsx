    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{0E202FBD-EB4B-4934-B40F-F3C3BA396DE0}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;SELECT * FROM [&quot; + &#xA;((FINDSTRING(LOWER(@[User::CurrentFilePath]), &quot;march&quot;, 1) &gt; 0) ? &quot;Mar&quot; : &#xA;((FINDSTRING(LOWER(@[User::CurrentFilePath]), &quot;april&quot;, 1) &gt; 0) ? &quot;Apr&quot; : &#xA;  ((FINDSTRING(LOWER(@[User::CurrentFilePath]), &quot;may&quot;, 1) &gt; 0) ? &quot;May&quot; : &quot;Apr&quot;))) &#xA;+ &quot;$A8:Z]&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="TargetSheetName">
      <DTS:VariableValue
        DTS:DataType="8">SELECT * FROM [Apr$A8:Z]</DTS:VariableValue>
    </DTS:Variable>
