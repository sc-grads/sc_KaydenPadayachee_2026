  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\Creating tables"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{865E1554-412C-40B5-85DC-DA7286CE5907}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Creating tables"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{CE1D72E8-76C3-4D81-A71D-A5A06E325FC4}"
          SQLTask:SqlStatementSource="-- ==========================================&#xA;-- 1. DATABASE SETUP&#xA;-- ==========================================&#xA;IF NOT EXISTS (SELECT * FROM sys.databases WHERE name = 'TimesheetKPDB')&#xA;BEGIN&#xA;    CREATE DATABASE TimesheetKPDB&#xA;END;&#xA;GO&#xA; &#xA;USE TimesheetKPDB;&#xA;GO&#xA;-- ==========================================&#xA;-- 2. MASTER &amp; DIMENSION TABLES&#xA;-- ==========================================&#xA;IF OBJECT_ID('dbo.AuditLog', 'U') IS NULL &#xA;BEGIN&#xA;    CREATE TABLE dbo.AuditLog (&#xA;        AuditID INT IDENTITY(1,1) CONSTRAINT PK_AuditLog PRIMARY KEY,&#xA;        PackageName NVARCHAR(100) NOT NULL CONSTRAINT DF_AuditLog_Pkg DEFAULT 'GraduateTimesheet_ETL',&#xA;        TaskName NVARCHAR(100) NOT NULL CONSTRAINT DF_AuditLog_Task DEFAULT 'Clean and Normalize Core Tables',&#xA;        FileName NVARCHAR(260) NULL,&#xA;        RowsStaged INT NOT NULL CONSTRAINT DF_AuditLog_Staged DEFAULT 0,&#xA;        InsertsProcessed INT NOT NULL CONSTRAINT DF_AuditLog_Inserts DEFAULT 0,&#xA;        UpdatesProcessed INT NOT NULL CONSTRAINT DF_AuditLog_Updates DEFAULT 0,&#xA;        DeletesProcessed INT NOT NULL CONSTRAINT DF_AuditLog_Deletes DEFAULT 0,&#xA;        LeaveRowsProcessed INT NOT NULL CONSTRAINT DF_AuditLog_Leave DEFAULT 0,&#xA;        Status NVARCHAR(20) NOT NULL,&#xA;        [Message] NVARCHAR(MAX) NULL,&#xA;        LogTimestamp DATETIME CONSTRAINT DF_AuditLog_Time DEFAULT GETDATE(),&#xA;        ExecutedBy NVARCHAR(100) NOT NULL CONSTRAINT DF_AuditLog_User DEFAULT SYSTEM_USER&#xA;    );&#xA; &#xA;    ALTER TABLE dbo.AuditLog ADD CONSTRAINT CK_AuditLog_Status CHECK (Status IN ('Running', 'Success', 'Failed'));&#xA;END;&#xA;GO&#xA; &#xA;IF OBJECT_ID('dbo.Client', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE dbo.Client (&#xA;        ClientID INT IDENTITY(1,1) CONSTRAINT PK_Client PRIMARY KEY,&#xA;        ClientName VARCHAR(200) NOT NULL&#xA;    );&#xA;END;&#xA; &#xA;IF OBJECT_ID('dbo.Employee', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE dbo.Employee (&#xA;        EmployeeID INT IDENTITY(1,1) CONSTRAINT PK_Employee PRIMARY KEY,&#xA;        FirstName NVARCHAR(150) NOT NULL,&#xA;        LastName NVARCHAR(150) NULL&#xA;    );&#xA;END;&#xA; &#xA;-- ==========================================&#xA;-- 3. LEAVE TABLE&#xA;-- ==========================================&#xA;IF OBJECT_ID('dbo.Leave', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE dbo.Leave (&#xA;        LeaveID INT IDENTITY(1,1) CONSTRAINT PK_Leave PRIMARY KEY,&#xA;        EmployeeID INT NULL CONSTRAINT FK_Leave_Employee FOREIGN KEY REFERENCES dbo.Employee(EmployeeID),&#xA;        LeaveDate DATE NULL,&#xA;        LeaveType NVARCHAR(250) NOT NULL&#xA;    );&#xA;END;&#xA; &#xA;-- ==========================================&#xA;-- 4. STAGING &amp; FACT TIMESHEET TABLES&#xA;-- ==========================================&#xA;IF OBJECT_ID('dbo.StagingTimesheet', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE dbo.StagingTimesheet (&#xA;        StagingID INT IDENTITY(1,1) CONSTRAINT PK_StagingTimesheet PRIMARY KEY,&#xA;        EmployeeSourceFile NVARCHAR(MAX),&#xA;        RawDate NVARCHAR(50),&#xA;        RawDayOfWeek NVARCHAR(50),&#xA;        RawClient NVARCHAR(150),&#xA;        RawProjectName NVARCHAR(150),&#xA;        RawDescription NVARCHAR(MAX),&#xA;        RawBillableStatus NVARCHAR(50),&#xA;        RawComments NVARCHAR(MAX),&#xA;        RawHoursWorked NVARCHAR(50), &#xA;        RawStartTime NVARCHAR(50),&#xA;        RawEndTime NVARCHAR(50),&#xA;        EmployeeName NVARCHAR(MAX)&#xA;    );&#xA;END;&#xA; &#xA;IF OBJECT_ID('dbo.Timesheet', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE dbo.Timesheet (&#xA;        TimesheetID INT IDENTITY(1,1) CONSTRAINT PK_Timesheet PRIMARY KEY,&#xA;        EmployeeID INT NULL CONSTRAINT FK_Timesheet_Employee FOREIGN KEY REFERENCES dbo.Employee(EmployeeID),&#xA;        ClientID INT NULL CONSTRAINT FK_Timesheet_Client FOREIGN KEY REFERENCES dbo.Client(ClientID),&#xA;        WorkDate DATE NULL,&#xA;        DayOfWeek NVARCHAR(50) NULL,         &#xA;        BillableStatus NVARCHAR(50) NULL,    &#xA;        StartTime TIME NULL,&#xA;        EndTime TIME NULL,&#xA;        HoursWorked NVARCHAR(50) NULL, &#xA;        TaskDescription NVARCHAR(MAX) NULL,&#xA;        Comments NVARCHAR(MAX) NULL,&#xA;        LastUpdatedDate DATETIME CONSTRAINT DF_Timesheet_LastUpdate DEFAULT GETDATE()&#xA;    );&#xA;END;&#xA; &#xA;IF OBJECT_ID('dbo.StagingTimesheet', 'U') IS NOT NULL&#xA;    TRUNCATE TABLE dbo.StagingTimesheet;&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Loops through Files and folders"
      DTS:CreationName="STOCK:FOREACHLOOP"
      DTS:DelayValidation="True"
      DTS:Description="Foreach Loop Container"
      DTS:DTSID="{D8712818-B387-452D-A3D0-3A4949FB285A}"
      DTS:ExecutableType="STOCK:FOREACHLOOP"
      DTS:LocaleID="-1"
      DTS:ObjectName="Loops through Files and folders">
      <DTS:ForEachEnumerator
        DTS:CreationName="Microsoft.ForEachFileEnumerator"
        DTS:DTSID="{CFF0D8D4-07B2-464A-8BC2-4EE9C0C3E6CD}"
        DTS:ObjectName="{CFF0D8D4-07B2-464A-8BC2-4EE9C0C3E6CD}">
        <DTS:PropertyExpression
          DTS:Name="Directory">@[User::RootFolderPath]</DTS:PropertyExpression>
        <DTS:ObjectData>
          <ForEachFileEnumeratorProperties>
            <FEFEProperty
              Folder="C:\Timesheets\" />
            <FEFEProperty
              FileSpec="*.xlsx" />
            <FEFEProperty
              FileNameRetrievalType="0" />
            <FEFEProperty
              Recurse="-1" />
          </ForEachFileEnumeratorProperties>
        </DTS:ObjectData>
      </DTS:ForEachEnumerator>
      <DTS:Variables />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\Loops through Files and folders\Expression Task"
          DTS:CreationName="Microsoft.ExpressionTask"
          DTS:Description="Expression Task"
          DTS:DTSID="{074B5FC5-1E4D-4B01-92AF-F5CF7E6DE936}"
          DTS:ExecutableType="Microsoft.ExpressionTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Expression Task"
          DTS:TaskContact="Expression Task;Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <ExpressionTask
              Expression="@[User::CurrentFilePath] =  @[User::CurrentFilePath]" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Loops through Files and folders\Get names"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{CACF6643-4C51-4F7D-83D2-7A28913C153C}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Get names"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{F6973623-8840-45BE-BDE7-396DC71F92C6}"
              SQLTask:SqlStatementSource="DECLARE @EmpName NVARCHAR(150) = ?;&#xA;DECLARE @SrcFile NVARCHAR(255) = ?;&#xA; &#xA;UPDATE StagingTimesheet &#xA;SET EmployeeName = @EmpName, &#xA;    EmployeeSourceFile = @SrcFile &#xA;WHERE EmployeeSourceFile IS NULL &#xA;   OR LTRIM(RTRIM(EmployeeSourceFile)) = '';" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="0"
                SQLTask:DtsVariableName="User::ExtractedEmployeeName"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="130"
                SQLTask:ParameterSize="-1" />
              <SQLTask:ParameterBinding
                SQLTask:ParameterName="1"
                SQLTask:DtsVariableName="User::ExtractedFileName"
                SQLTask:ParameterDirection="Input"
                SQLTask:DataType="130"
                SQLTask:ParameterSize="-1" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Loops through Files and folders\Populating tables"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{1D7C8E5F-914E-4BE5-B1A7-44ACD3A3DDEF}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Populating tables"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{F6973623-8840-45BE-BDE7-396DC71F92C6}"
              SQLTask:SqlStatementSource="USE TimesheetKPDB;&#xA;GO&#xA; &#xA;-- ==========================================&#xA;-- PRE-EXECUTION: FILE IDENTIFICATION&#xA;-- ==========================================&#xA;DECLARE @FullFilePath NVARCHAR(MAX) = '';&#xA;DECLARE @FileName NVARCHAR(260) = 'Unknown_File';&#xA; &#xA;SELECT TOP 1 @FullFilePath = EmployeeSourceFile &#xA;FROM dbo.StagingTimesheet &#xA;WHERE EmployeeSourceFile IS NOT NULL;&#xA; &#xA;IF @FullFilePath &lt;&gt; ''&#xA;BEGIN&#xA;    SET @FileName = CASE &#xA;        WHEN CHARINDEX('\', @FullFilePath) &gt; 0 &#xA;        THEN RIGHT(@FullFilePath, CHARINDEX('\', REVERSE(@FullFilePath)) - 1) &#xA;        ELSE @FullFilePath &#xA;    END;&#xA;END;&#xA; &#xA;DECLARE @RowsStaged INT = 0;&#xA;DECLARE @TSInserted INT = 0;&#xA;DECLARE @TSUpdated INT = 0;&#xA;DECLARE @TSDeleted INT = 0;&#xA;DECLARE @LeaveInserted INT = 0;&#xA;DECLARE @CurrentAuditID INT = 0;&#xA; &#xA;SELECT @RowsStaged = COUNT(*) FROM dbo.StagingTimesheet;&#xA; &#xA;DECLARE @ActionTracker TABLE (ActionType VARCHAR(20));&#xA;DECLARE @LeaveTracker TABLE (ActionType VARCHAR(20));&#xA; &#xA;BEGIN TRANSACTION;&#xA; &#xA;BEGIN TRY&#xA;    -- ==========================================&#xA;    -- STEP 1: INITIALIZE AUDIT ENTRY&#xA;    -- ==========================================&#xA;    INSERT INTO dbo.AuditLog (FileName, RowsStaged, Status, [Message], LogTimestamp)&#xA;    VALUES (@FileName, @RowsStaged, 'Running', 'Processing data pipelines...', GETDATE());&#xA;    SET @CurrentAuditID = SCOPE_IDENTITY();&#xA; &#xA;    -- ==========================================&#xA;    -- STEP 2: POPULATE DIMENSIONS (SPLIT ON THE FLY)&#xA;    -- ==========================================&#xA;    ;WITH ParsedStagingEmployees AS (&#xA;        SELECT DISTINCT &#xA;            EmployeeName,&#xA;            CASE &#xA;                WHEN CHARINDEX(' ', LTRIM(RTRIM(EmployeeName))) &gt; 0 &#xA;                THEN LEFT(LTRIM(RTRIM(EmployeeName)), CHARINDEX(' ', LTRIM(RTRIM(EmployeeName))) - 1)&#xA;                ELSE LTRIM(RTRIM(EmployeeName))&#xA;            END AS CleanedFirstName,&#xA;            CASE &#xA;                WHEN CHARINDEX(' ', LTRIM(RTRIM(EmployeeName))) &gt; 0 &#xA;                THEN RIGHT(LTRIM(RTRIM(EmployeeName)), LEN(LTRIM(RTRIM(EmployeeName))) - CHARINDEX(' ', LTRIM(RTRIM(EmployeeName))))&#xA;                ELSE ''&#xA;            END AS CleanedLastName&#xA;        FROM dbo.StagingTimesheet&#xA;        WHERE EmployeeName IS NOT NULL AND EmployeeName &lt;&gt; ''&#xA;    )&#xA;    INSERT INTO dbo.Employee (FirstName, LastName)&#xA;    SELECT p.CleanedFirstName, p.CleanedLastName &#xA;    FROM ParsedStagingEmployees p&#xA;    WHERE NOT EXISTS (&#xA;        SELECT 1 FROM dbo.Employee e &#xA;        WHERE e.FirstName = p.CleanedFirstName AND ISNULL(e.LastName, '') = p.CleanedLastName&#xA;    );&#xA; &#xA;    INSERT INTO Client (ClientName)&#xA;    SELECT DISTINCT ISNULL(NULLIF(LTRIM(RTRIM(RawClient)), ''), 'Internal') FROM StagingTimesheet&#xA;    WHERE RawClient IS NOT NULL AND RawClient &lt;&gt; ''&#xA;      AND NOT EXISTS (SELECT 1 FROM Client c WHERE c.ClientName = ISNULL(NULLIF(LTRIM(RTRIM(StagingTimesheet.RawClient)), ''), 'Internal'));&#xA; &#xA;    -- ==========================================&#xA;    -- STEP 3: MERGE FACT LEAVE&#xA;    -- ==========================================&#xA;    ;WITH DeduplicatedLeave AS (&#xA;        SELECT &#xA;            e.EmployeeID, &#xA;            TRY_CAST(st.RawDate AS DATE) AS LeaveDate,&#xA;            ISNULL(NULLIF(LTRIM(RTRIM(st.RawDescription)), ''), ISNULL(NULLIF(LTRIM(RTRIM(st.RawClient)), ''), 'General Leave')) AS LeaveType,&#xA;            ROW_NUMBER() OVER (&#xA;                PARTITION BY e.EmployeeID, TRY_CAST(st.RawDate AS DATE) &#xA;                ORDER BY st.StagingID DESC&#xA;            ) as RowNum&#xA;        FROM StagingTimesheet st&#xA;        INNER JOIN dbo.Employee e ON &#xA;            e.FirstName = CASE &#xA;                WHEN CHARINDEX(' ', LTRIM(RTRIM(st.EmployeeName))) &gt; 0 THEN LEFT(LTRIM(RTRIM(st.EmployeeName)), CHARINDEX(' ', LTRIM(RTRIM(st.EmployeeName))) - 1)&#xA;                ELSE LTRIM(RTRIM(st.EmployeeName)) END&#xA;            AND ISNULL(e.LastName, '') = CASE &#xA;                WHEN CHARINDEX(' ', LTRIM(RTRIM(st.EmployeeName))) &gt; 0 THEN RIGHT(LTRIM(RTRIM(st.EmployeeName)), LEN(LTRIM(RTRIM(st.EmployeeName))) - CHARINDEX(' ', LTRIM(RTRIM(st.EmployeeName))))&#xA;                ELSE '' END&#xA;        WHERE st.RawDate IS NOT NULL AND TRY_CAST(st.RawDate AS DATE) IS NOT NULL&#xA;          AND (LOWER(ISNULL(st.RawDescription, '')) LIKE '%leave%' OR LOWER(ISNULL(st.RawClient, '')) LIKE '%leave%')&#xA;          AND DATEPART(dw, TRY_CAST(st.RawDate AS DATE)) NOT IN (1, 7)&#xA;          AND LOWER(ISNULL(st.RawDescription, '')) &lt;&gt; 'public holiday'&#xA;    )&#xA;    MERGE dbo.Leave AS target&#xA;    USING (&#xA;        SELECT * FROM DeduplicatedLeave WHERE RowNum = 1&#xA;    ) AS source&#xA;    ON (target.EmployeeID = source.EmployeeID AND target.LeaveDate = source.LeaveDate)&#xA;    WHEN MATCHED THEN&#xA;        UPDATE SET &#xA;            target.LeaveType = source.LeaveType&#xA;    WHEN NOT MATCHED BY TARGET THEN&#xA;        INSERT (EmployeeID, LeaveDate, LeaveType)&#xA;        VALUES (source.EmployeeID, source.LeaveDate, source.LeaveType)&#xA;    OUTPUT $action INTO @LeaveTracker;&#xA; &#xA;    SELECT @LeaveInserted = COUNT(*) FROM @LeaveTracker WHERE ActionType = 'INSERT';&#xA; &#xA;    -- ==========================================&#xA;    -- STEP 4: MERGE FACT TIMESHEET&#xA;    -- ==========================================&#xA;    ;WITH DeduplicatedSource AS (&#xA;        SELECT &#xA;            e.EmployeeID, &#xA;            c.ClientID, &#xA;            TRY_CAST(st.RawDate AS DATE) AS WorkDate, &#xA;            ISNULL(NULLIF(LTRIM(RTRIM(st.RawDayOfWeek)), ''), DATENAME(weekday, TRY_CAST(st.RawDate AS DATE))) AS DayOfWeek,&#xA;            ISNULL(NULLIF(LTRIM(RTRIM(st.RawBillableStatus)), ''), 'Non-Billable') AS BillableStatus,&#xA;            TRY_CAST(st.RawStartTime AS TIME) AS StartTime, &#xA;            TRY_CAST(st.RawEndTime AS TIME) AS EndTime,&#xA;            ISNULL(NULLIF(LTRIM(RTRIM(st.RawHoursWorked)), ''), '00:00') AS HoursWorked, &#xA;            ISNULL(NULLIF(LTRIM(RTRIM(st.RawDescription)), ''), 'No description provided') AS TaskDescription,&#xA;            ISNULL(NULLIF(LTRIM(RTRIM(st.RawComments)), ''), 'None') AS Comments,&#xA;            ROW_NUMBER() OVER (&#xA;                PARTITION BY e.EmployeeID, TRY_CAST(st.RawDate AS DATE), TRY_CAST(st.RawStartTime AS TIME) &#xA;                ORDER BY st.StagingID DESC&#xA;            ) as RowNum&#xA;        FROM dbo.StagingTimesheet st&#xA;        INNER JOIN dbo.Employee e ON &#xA;            e.FirstName = CASE &#xA;                WHEN CHARINDEX(' ', LTRIM(RTRIM(st.EmployeeName))) &gt; 0 THEN LEFT(LTRIM(RTRIM(st.EmployeeName)), CHARINDEX(' ', LTRIM(RTRIM(st.EmployeeName))) - 1)&#xA;                ELSE LTRIM(RTRIM(st.EmployeeName)) END&#xA;            AND ISNULL(e.LastName, '') = CASE &#xA;                WHEN CHARINDEX(' ', LTRIM(RTRIM(st.EmployeeName))) &gt; 0 THEN RIGHT(LTRIM(RTRIM(st.EmployeeName)), LEN(LTRIM(RTRIM(st.EmployeeName))) - CHARINDEX(' ', LTRIM(RTRIM(st.EmployeeName))))&#xA;                ELSE '' END&#xA;        INNER JOIN dbo.Client c ON c.ClientName = ISNULL(NULLIF(LTRIM(RTRIM(st.RawClient)), ''), 'Internal')&#xA;        WHERE st.RawDate IS NOT NULL AND TRY_CAST(st.RawDate AS DATE) IS NOT NULL&#xA;          AND LOWER(ISNULL(st.RawDescription, '')) NOT LIKE '%leave%' AND LOWER(ISNULL(st.RawClient, '')) NOT LIKE '%leave%'&#xA;          AND DATEPART(dw, TRY_CAST(st.RawDate AS DATE)) NOT IN (1, 7) AND LOWER(ISNULL(st.RawDescription, '')) &lt;&gt; 'public holiday'&#xA;          AND LTRIM(RTRIM(ISNULL(st.RawStartTime, ''))) &lt;&gt; '' AND LTRIM(RTRIM(ISNULL(st.RawEndTime, ''))) &lt;&gt; '' AND LTRIM(RTRIM(ISNULL(st.RawDescription, ''))) &lt;&gt; ''&#xA;    )&#xA;    MERGE dbo.Timesheet AS target&#xA;    USING (&#xA;        SELECT * FROM DeduplicatedSource WHERE RowNum = 1&#xA;    ) AS source&#xA;    ON (target.EmployeeID = source.EmployeeID AND target.WorkDate = source.WorkDate AND target.StartTime = source.StartTime)&#xA;    WHEN MATCHED AND (&#xA;        ISNULL(target.ClientID, 0) != ISNULL(source.ClientID, 0) OR&#xA;        ISNULL(target.EndTime, '00:00:00') != ISNULL(source.EndTime, '00:00:00') OR&#xA;        ISNULL(target.HoursWorked, '') != ISNULL(source.HoursWorked, '') OR&#xA;        ISNULL(target.TaskDescription, '') != ISNULL(source.TaskDescription, '') OR&#xA;        ISNULL(target.Comments, '') != ISNULL(source.Comments, '') OR&#xA;        ISNULL(target.BillableStatus, '') != ISNULL(source.BillableStatus, '') OR&#xA;        ISNULL(target.DayOfWeek, '') != ISNULL(source.DayOfWeek, '')&#xA;    ) THEN&#xA;        UPDATE SET &#xA;            target.ClientID = source.ClientID,&#xA;            target.EndTime = source.EndTime, &#xA;            target.HoursWorked = source.HoursWorked,&#xA;            target.TaskDescription = source.TaskDescription,&#xA;            target.Comments = source.Comments, &#xA;            target.BillableStatus = source.BillableStatus, &#xA;            target.DayOfWeek = source.DayOfWeek, &#xA;            target.LastUpdatedDate = GETDATE()&#xA;    WHEN NOT MATCHED BY TARGET THEN&#xA;        INSERT (EmployeeID, ClientID, WorkDate, DayOfWeek, BillableStatus, StartTime, EndTime, HoursWorked, TaskDescription, Comments)&#xA;        VALUES (source.EmployeeID, source.ClientID, source.WorkDate, source.DayOfWeek, source.BillableStatus, source.StartTime, source.EndTime, source.HoursWorked, source.TaskDescription, source.Comments)&#xA;    OUTPUT $action INTO @ActionTracker;&#xA; &#xA;    SELECT @TSInserted = COUNT(*) FROM @ActionTracker WHERE ActionType = 'INSERT';&#xA;    SELECT @TSUpdated = COUNT(*) FROM @ActionTracker WHERE ActionType = 'UPDATE';&#xA; &#xA;    -- ==========================================&#xA;    -- STEP 5: HOUSEKEEPING DELETIONS&#xA;    -- ==========================================&#xA;    DELETE t&#xA;    FROM dbo.Timesheet t&#xA;    INNER JOIN dbo.StagingTimesheet st ON st.RawDate = CAST(t.WorkDate AS NVARCHAR(50))&#xA;    INNER JOIN dbo.Employee e ON e.EmployeeID = t.EmployeeID &#xA;        AND e.FirstName = CASE &#xA;            WHEN CHARINDEX(' ', LTRIM(RTRIM(st.EmployeeName))) &gt; 0 THEN LEFT(LTRIM(RTRIM(st.EmployeeName)), CHARINDEX(' ', LTRIM(RTRIM(st.EmployeeName))) - 1)&#xA;            ELSE LTRIM(RTRIM(st.EmployeeName)) END&#xA;        AND ISNULL(e.LastName, '') = CASE &#xA;            WHEN CHARINDEX(' ', LTRIM(RTRIM(st.EmployeeName))) &gt; 0 THEN RIGHT(LTRIM(RTRIM(st.EmployeeName)), LEN(LTRIM(RTRIM(st.EmployeeName))) - CHARINDEX(' ', LTRIM(RTRIM(st.EmployeeName))))&#xA;            ELSE '' END&#xA;    WHERE (st.RawHoursWorked = '00:00' OR st.RawHoursWorked = '0' OR st.RawHoursWorked IS NULL) &#xA;      AND t.WorkDate = TRY_CAST(st.RawDate AS DATE) AND t.StartTime = TRY_CAST(st.RawStartTime AS TIME);&#xA; &#xA;    SET @TSDeleted = @@ROWCOUNT;&#xA; &#xA;    -- ==========================================&#xA;    -- STEP 6: CONDITIONAL AUDIT FINALIZE OR REMOVAL&#xA;    -- ==========================================&#xA;    IF (@TSInserted &gt; 0 OR @TSUpdated &gt; 0 OR @TSDeleted &gt; 0 OR @LeaveInserted &gt; 0)&#xA;    BEGIN&#xA;        UPDATE dbo.AuditLog&#xA;        SET InsertsProcessed = @TSInserted,&#xA;            UpdatesProcessed = @TSUpdated,&#xA;            DeletesProcessed = @TSDeleted,&#xA;            LeaveRowsProcessed = @LeaveInserted,&#xA;            Status = 'Success',&#xA;            [Message] = 'File execution metrics fully recorded with split employee names and hour tracking.'&#xA;        WHERE AuditID = @CurrentAuditID;&#xA;    END&#xA;    ELSE&#xA;    BEGIN&#xA;        DELETE FROM dbo.AuditLog&#xA;        WHERE AuditID = @CurrentAuditID;&#xA;    END;&#xA; &#xA;    -- ==========================================&#xA;    -- STEP 7: CYCLE INITIALIZATION&#xA;    -- ==========================================&#xA;    TRUNCATE TABLE dbo.StagingTimesheet;&#xA;    COMMIT TRANSACTION;&#xA; &#xA;END TRY&#xA;BEGIN CATCH&#xA;    IF @@TRANCOUNT &gt; 0 ROLLBACK TRANSACTION;&#xA;    IF @CurrentAuditID &gt; 0&#xA;    BEGIN&#xA;        UPDATE dbo.AuditLog&#xA;        SET Status = 'Failed', [Message] = 'CRITICAL PROCESSING FAILURE: ' + ERROR_MESSAGE()&#xA;        WHERE AuditID = @CurrentAuditID;&#xA;    END&#xA;    ELSE&#xA;    BEGIN&#xA;        INSERT INTO dbo.AuditLog (FileName, RowsStaged, Status, [Message], LogTimestamp)&#xA;        VALUES (@FileName, @RowsStaged, 'Failed', 'CRITICAL INITIALIZATION FAILURE: ' + ERROR_MESSAGE(), GETDATE());&#xA;    END;&#xA;    THROW;&#xA;END CATCH;&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
