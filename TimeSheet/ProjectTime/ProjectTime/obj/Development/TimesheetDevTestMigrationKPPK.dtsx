    <DTS:Variable
      DTS:CreationName=""
      DTS:DTSID="{0E202FBD-EB4B-4934-B40F-F3C3BA396DE0}"
      DTS:EvaluateAsExpression="True"
      DTS:Expression="&quot;SELECT * FROM [&quot; + &#xA;(FINDSTRING(LOWER(@[User::CurrentFilePath]), &quot;march&quot;, 1) &gt; 0 ? &quot;Mar&quot; : &#xA;(FINDSTRING(LOWER(@[User::CurrentFilePath]), &quot;april&quot;, 1) &gt; 0 ? &quot;Apr&quot; : &#xA;(FINDSTRING(LOWER(@[User::CurrentFilePath]), &quot;may&quot;, 1) &gt; 0 ? &quot;May&quot; : &#xA;(FINDSTRING(LOWER(@[User::CurrentFilePath]), &quot;june&quot;, 1) &gt; 0 ? &quot;Jun&quot; : &#xA;(FINDSTRING(LOWER(@[User::CurrentFilePath]), &quot;july&quot;, 1) &gt; 0 ? &quot;Jul&quot; : &#xA;(FINDSTRING(LOWER(@[User::CurrentFilePath]), &quot;august&quot;, 1) &gt; 0 ? &quot;Aug&quot; : &#xA;(FINDSTRING(LOWER(@[User::CurrentFilePath]), &quot;september&quot;, 1) &gt; 0 ? &quot;Sep&quot; : &#xA;(FINDSTRING(LOWER(@[User::CurrentFilePath]), &quot;october&quot;, 1) &gt; 0 ? &quot;Oct&quot; : &#xA;(FINDSTRING(LOWER(@[User::CurrentFilePath]), &quot;november&quot;, 1) &gt; 0 ? &quot;Nov&quot; : &#xA;(FINDSTRING(LOWER(@[User::CurrentFilePath]), &quot;december&quot;, 1) &gt; 0 ? &quot;Dec&quot; : &quot;UnknownMonth&quot;))))))))))&#xA;+ &quot;$A8:Z]&quot;"
      DTS:IncludeInDebugDump="2345"
      DTS:Namespace="User"
      DTS:ObjectName="SheetName">
      <DTS:VariableValue
        DTS:DataType="8">SELECT * FROM [UnknownMonth$A8:Z]</DTS:VariableValue>
    </DTS:Variable>
