            //MessageBox.Show(Dts.Variables["User::TargetSheetName"].Value.ToString());
            string fullPath = Dts.Variables["User::CurrentFilePath"].Value.ToString();


            Dts.Variables["User::ExtractedFileName"].Value = System.IO.Path.GetFileName(fullPath);

            Dts.Variables["User::ExtractedEmployeeName"].Value = System.IO.Path.GetFileName(System.IO.Path.GetDirectoryName(fullPath));


